# DataVault environment variables — set these in Netlify:
# Site configuration → Environment variables. See setup/SETUP.md.

STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=DataVault <hello@yourdomain.com>

# Receives "payout due" and "document needs review" emails
ADMIN_EMAIL=you@yourdomain.com

# Optional: smarter listings, photo reading, automatic document checks
GEMINI_API_KEY=your_gemini_api_key_here
