# Environment Variables for DataVault
# Copy this file to .env and fill in your values.
# In Netlify, set these in: Site settings → Environment variables

# ── Stripe ─────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook signing secret — get from: https://dashboard.stripe.com/webhooks
# Set your webhook endpoint to: https://your-site.netlify.app/.netlify/functions/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Email Delivery (Resend) ─────────────────────────────────────
# Required to send dataset download emails to winning buyers.
# Sign up free at: https://resend.com
# Verify your sending domain in Resend → then update the 'from' address in release-dataset.js
RESEND_API_KEY=re_your_resend_api_key_here

# ── Optional ────────────────────────────────────────────────────
# Gemini API Key (if using AI features)
GEMINI_API_KEY=your_gemini_api_key_here
